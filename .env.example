# Copy to .env.local and fill in. Never commit real secrets.

# --- Database (Postgres / Supabase) ----------------------------------------
# App runtime: use the *transaction* pooler (port 6543) — required for serverless.
#   postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Migrations / drizzle-kit: use the *session* pooler (5432) or the direct URL.
DIRECT_URL=

# --- Auth.js (NextAuth v5) -------------------------------------------------
# Generate with:  openssl rand -base64 33
AUTH_SECRET=
# Only needed if not running on localhost / behind a proxy:
# AUTH_URL=http://localhost:3000

# --- Holded integration ----------------------------------------------------
# Holded > Settings > Developers > API key
HOLDED_API_KEY=
# Base URL — leave as-is unless Holded changes it
HOLDED_API_BASE=https://api.holded.com/api
# A secret you choose; configure the same value on the Holded webhook so we can
# verify incoming calls (sent as the `key` query param or `X-Webhook-Secret` header).
HOLDED_WEBHOOK_SECRET=

# --- Habitat-one website push ---------------------------------------------
# Fine-grained PAT met Contents: Read+Write op alleen `nickhouter-ctrl/Habitat-one`.
# Maak hier aan: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN_HABITAT_ONE=
# Default is voldoende; overschrijf bij naamwijziging
WEBSITE_REPO=nickhouter-ctrl/Habitat-one
WEBSITE_BRANCH=main

# --- Supabase Storage ------------------------------------------------------
# Bucket-namen — defaults zijn meestal prima
# SUPABASE_STORAGE_BUCKET=property-images
# SUPABASE_PRODUCT_BUCKET=product-images
# SUPABASE_PO_BUCKET=purchase-order-files

# --- Gmail (IMAP-poll voor de mail-inbox + SMTP voor uitgaande mail) --------
# Gmail-adres + een Gmail app-wachtwoord (Account > Beveiliging > App-wachtwoorden,
# vereist 2-staps-verificatie). Het CRM pollt dit postvak via IMAP.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optioneel tweede postvak (bv. purchase@) — een apart Gmail-account met een
# eigen app-wachtwoord. Leeg laten als er maar één postvak is.
GMAIL_PURCHASE_USER=
GMAIL_PURCHASE_APP_PASSWORD=

# Uitgaande klant-mails (offertes, bevestigingen) gaan standaard via Gmail
# (verstuurd vanaf GMAIL_USER). Resend is een optionele terugval:
# RESEND_API_KEY=
# EMAIL_FROM=hi@habitat-one.com

# --- Meldingen -------------------------------------------------------------
# Adres dat een melding krijgt als een klant een offerte accepteert of afwijst.
# Leeg laten = valt terug op het bedrijfsadres (COMPANY_EMAIL / hi@habitat-one.com).
NOTIFY_EMAIL=
# Elke uitgaande klantmail (offerte/factuur/herinnering/levering) krijgt een
# VERBORGEN kopie (BCC) naar dit adres zodat je meeleest zonder dat de klant het
# ziet. Leeg = NOTIFY_EMAIL, anders het verzendadres GMAIL_USER (hi@habitat-one.com).
EMAIL_BCC=
# Vaste, altijd-aanwezige BCC op ELKE uitgaande mail (ook account-activatie en
# website-notificaties die lib/email.ts overslaan). Komma-gescheiden voor meerdere
# adressen. Leeg = default nick@habitat-one.com. Het bedrijfsadres
# hi@habitat-one.com leest ALTIJD mee (hard toegevoegd in lib/mail-bcc.ts), ook
# als je deze var overschrijft.
EMAIL_BCC_ALWAYS=
# Betaalherinneringen naar klanten: pas versturen als dit op "true" staat. Leeg of
# "false" = de cron draait maar verstuurt niets (veilig tijdens het inrichten).
PAYMENT_REMINDERS_ENABLED=
# Review-verzoeken (Google-review) ±3 weken na levering: pas versturen als dit op
# "true" staat. De handmatige knop op de klantpagina werkt altijd.
REVIEW_REQUESTS_ENABLED=
# Unieke AI-productteksten (NL/DE/EN/ES) voor meubels genereren: pas actief als dit
# op "true" staat. De cron verwerkt dan ~12 meubels per run tot de lijst leeg is en
# stopt vanzelf. Vereist ANTHROPIC_API_KEY. Eenmalig ~€15-25 voor alle meubels.
AI_DESCRIPTIONS_ENABLED=
# Google-review-link (standaard de Habitat One-pagina als dit leeg is).
REVIEW_URL=
# Absolute URL naar het logo voor in e-mails (klanten zien dan het logo i.p.v. de
# tekst-merknaam). Bv. https://<crm-domein>/brand/habitat-one-logo.png. Leeg = val
# terug op de tekst-wordmark.
EMAIL_LOGO_URL=

# --- Bedrijfsgegevens op PDF/mail (optioneel — defaults in lib/company.ts) --
# Adres in twee regels op de PDF: straat, en daaronder postcode + plaats + land.
# COMPANY_ADDRESS_STREET=Camí de la Fontana 3, Locales 2, 3 en 5
# COMPANY_ADDRESS_REGION=03730 Jávea (Alicante), España

# Leads-generator — Google Places API (New) key om B2B-bedrijven te zoeken.
# Leeg = zoeken uit; CSV-import werkt dan nog wel. Places API (New) aanzetten in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Vaste basis-URL voor links in uitgaande mails (offerte-accept, boekingen).
# Zonder deze var valt het systeem terug op de Host-header van het verzoek.
APP_URL=https://habitat-crm-delta.vercel.app

# Meldingen inkoopfacturen (goedkeuringspoort). Leeg = NOTIFY_EMAILS.
INVOICE_NOTIFY_EMAILS=nick@habitat-one.com,hans@habitat-one.com
# Zet op "false" om de ochtendsamenvatting uit te zetten (standaard aan).
PURCHASE_INVOICE_DIGEST_ENABLED=true
# Domeinen die facturen alleen dóórsturen — een afkeuring gaat daar nooit naartoe.
FORWARDER_DOMAINS=

# --- Cron & feeds ----------------------------------------------------------
# VERPLICHT in productie: Vercel-cron-routes weigeren alles (503) zonder deze.
# Zet dezelfde waarde als CRON_SECRET in de Vercel-projectinstellingen.
# Genereer met:  openssl rand -base64 33
CRON_SECRET=
# Token voor de iCal-agendafeed (/api/calendar?token=...). Leeg = feed uit.
CALENDAR_FEED_TOKEN=

# --- Klantportal -----------------------------------------------------------
# HMAC-secret voor portal-sessietokens. Zonder deze var faalt de portal dicht.
PORTAL_JWT_SECRET=

# --- Supabase Storage (foto's, PO-bestanden, catalogi) ----------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_CATALOG_BUCKET=catalogs

# --- AI (factuur-extractie, productteksten) ---------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# --- OpenRouteService (rijafstand / adres-autocomplete bij leveringen) ------
ORS_API_KEY=

# --- Google Search Console + Analytics + Business Profile (rapporten) -------
SC_CLIENT_ID=
SC_CLIENT_SECRET=
SC_REFRESH_TOKEN=
# SC_SITE_URL=sc-domain:habitat-one.com
# GA_PROPERTY_ID=
# GBP_LOCATION_ID=

# --- Website-koppeling (habitat-one.com) ------------------------------------
# Secret + URL voor on-demand revalidatie van de website na een product-push.
WEBSITE_REVALIDATE_SECRET=
# WEBSITE_REVALIDATE_URL=
# WEBSITE_URL=https://habitat-one.com

# --- Marketing-module: Meta (Facebook/Instagram) ads ------------------------
# Systeemgebruiker-token uit Business Manager (System User > Generate Token).
# Alleen als omgevingsvariabele — nooit in de database of een client component.
META_ACCESS_TOKEN=
# Advertentieaccount-id, ZONDER "act_"-prefix (die zet de client er zelf voor).
META_AD_ACCOUNT_ID=
# Facebook-pagina-id voor de object_story_spec van adcreatives.
META_PAGE_ID=
# Instagram-account-id (zakelijk) voor de Instagram-plaatsing + /me/media-sync.
IG_USER_ID=
# Token voor de Instagram Graph API media-sync (mag = META_ACCESS_TOKEN zijn
# als de systeemgebruiker ook instagram_basic-rechten heeft).
IG_ACCESS_TOKEN=
# Ad Library / ads_archive (fase 5, concurrentiemonitor). Vereist een developer-
# app + identiteitsverificatie; verloopt ±60 dagen — de UI waarschuwt vooraf.
META_ADS_ARCHIVE_TOKEN=
# Graph API-versie — defaults in lib/meta/client.ts, alleen zetten bij afwijking.
# META_GRAPH_VERSION=v23.0
# Bucket voor marketing-assets en renders (default in code).
# SUPABASE_MARKETING_BUCKET=marketing-assets

# --- GS1 (barcodes) ---------------------------------------------------------
# GS1_COMPANY_PREFIX=

# --- Seed (npm run db:seed) -------------------------------------------------
# VERPLICHT voor het seed-script; er is bewust geen standaardwachtwoord.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
